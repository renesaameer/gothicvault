# Supabase connection — auto-injected by Lovable when project is connected.
# For local dev or self-hosting, copy this file to .env and fill in values
# from your Supabase project's API settings page.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ── Edge Function Secrets (set in Supabase Dashboard → Edge Functions → Secrets) ──
# These are NOT read by the frontend. Do not put them in .env.
#
# Required for courier integrations:
#   STEADFAST_API_KEY
#   STEADFAST_SECRET_KEY
#   ECOMDRIVE_API_KEY
#
# Auto-provided by Supabase (do not set manually):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   SUPABASE_DB_URL, SUPABASE_JWKS, LOVABLE_API_KEY

# ── Optional: local DB tooling (only for `npm run db:verify` / `db:export`) ──
# Copy the connection string from Supabase → Project Settings → Database.
# SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"